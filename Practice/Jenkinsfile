pipeline {
    agent any

    environment {
        JUNIT_CONSOLE = 'C:\\Users\\ysjeong\\Downloads\\junit-platform-console-standalone-1.7.1.jar'
    }

    stages {
        stage('Build') {
            steps {
                bat '''
                if exist classes rmdir /s /q classes
                mkdir classes

                dir /s /b Practice\\src\\*.java > sources.txt
                type sources.txt

                javac -encoding UTF-8 -cp "%JUNIT_CONSOLE%" -d classes @sources.txt
                '''
            }
        }

        stage('Test') {
            steps {
                bat '''
                if exist test_results.txt del test_results.txt

                java -jar "%JUNIT_CONSOLE%" --disable-ansi-colors --class-path classes --select-class JunitTest > test_results.txt 2>&1

                set TEST_EXIT=%ERRORLEVEL%

                type test_results.txt

                exit /b %TEST_EXIT%
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'test_results.txt', fingerprint: true, allowEmptyArchive: true
        }

        failure {
            echo 'Build or test failed'
        }

        success {
            echo 'Build and test succeeded'
        }
    }
}
