pipeline {
    agent any

    environment {
        JUNIT_HOME = 'C:\\Users\\ysjeong\\Downloads\\eclipse-java-2026-03-R-win32-x86_64\\eclipse\\plugins'
    }

    stages {
        stage('Build') {
            steps {
                bat '''
                if exist classes rmdir /s /q classes
                mkdir classes

                dir "%JUNIT_HOME%\\junit*.jar"
                dir "%JUNIT_HOME%\\org.opentest4j*.jar"
                dir "%JUNIT_HOME%\\org.apiguardian*.jar"

                dir /s /b Practice\\src\\*.java > sources.txt
                type sources.txt

                javac -encoding UTF-8 -cp "%JUNIT_HOME%\\*" -d classes @sources.txt
                '''
            }
        }

        stage('Test') {
            steps {
                bat '''
                java -cp "classes;%JUNIT_HOME%\\*" org.junit.platform.console.ConsoleLauncher --scan-classpath > test_results.txt
                type test_results.txt
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'test_results.txt', fingerprint: true, allowEmptyArchive: true
        }

        failure {
            echo 'Build or test failed'
        }

        success {
            echo 'Build and test succeeded'
        }
    }
}
