pipeline {
      agent any

      stages {
          stage('Checkout') {
              steps {
                  // 소스코드 체크아웃
                  checkout scm
              }
          }

          stage('Build') {
              steps {
                  // Windows 환경이므로 bat 사용
                  bat 'if not exist classes mkdir classes'
                  bat 'javac -encoding UTF-8 -d classes Practice/src/**/*.java'
              }
          }

          stage('Test') {
              steps {
                  // JUnit 콘솔 JAR 실제 경로 반영
                  bat 'java -cp "classes;C:\\Users\\ysjeong\\Downloads\\eclipse-java-2026-03-R-win32-x86_64\\eclipse\
  \plugins\\junit-platform-console-standalone-1.7.1.jar" org.junit.platform.console.ConsoleLauncher --scan-classpath >
  Practice\\test_results.txt 2>&1'
              }
          }
      }

      post {
          always {
              archiveArtifacts artifacts: 'Practice/test_results.txt', allowEmptyArchive: true
          }
          failure {
              echo 'Build or test failed'
          }
          success {
              echo 'Build and test succeeded'
          }
      }
  }
