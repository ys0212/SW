pipeline {
      agent any
      stages {
          stage('Checkout') {
              steps {
                  checkout scm
              }
          }
          stage('Build') {
              steps {
                  bat 'javac -encoding UTF-8 -d classes Practice\\src\\**\\*.java'
              }
          }
          stage('Test') {
              steps {
                  bat 'java -cp "classes;lib\\*;path\\to\\eclipse\\plugins\\junit-platform-console-standalone-6.0.0.jar"
  org.junit.platform.console.ConsoleLauncher --scan-classpath > test_results.txt'
              }
      post {
          always {
              archiveArtifacts artifacts: 'test_results.txt', fingerprint: true
          }
          failure {
              echo 'Build or test failed'
          }
          success {
              echo 'Build and test succeeded'
          }
      }
  }
